# Example quadlet: published port and a private environment file. Put TLS and rate limits on a reverse proxy.
# Copy to ~/.config/containers/systemd/i2nclip.container, then:
# systemctl --user daemon-reload && systemctl --user start i2nclip.service

[Container]
Image=localhost/i2nclip:latest
ContainerName=i2nclip
PublishPort=8080:8080
EnvironmentFile=%h/.config/i2nclip/app.env
Environment=I2N_ORIGIN=https://clip.example.com

[Service]
Restart=always

[Install]
WantedBy=default.target
