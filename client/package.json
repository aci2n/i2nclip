{
  "name": "i2nclip-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./src/lib/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.extension.config.js",
    "check": "svelte-check --fail-on-warnings",
    "test": "node --test tests/*.test.js",
    "build:extension": "vite build --config vite.extension.config.js",
    "dev:extension": "npm run build:extension -- --watch",
    "e2e": "npm run build:extension && playwright test",
    "pack:extension": "npm run build:extension && cd dist/extension && zip -q -r -FS ../i2nclip.xpi . -x updates.json"
  },
  "dependencies": {
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte-check": "^4.3.0",
    "vite": "^8.3.4"
  }
}
