{
	"name": "i2nclip-client",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/aci2n/i2nclip"
	},
	"private": true,
	"type": "module",
	"exports": "./src/lib/index.js",
	"scripts": {
		"dev": "vite",
		"build": "npm run build:web",
		"check": "svelte-check --fail-on-warnings",
		"lint": "biome lint",
		"format:check": "biome check",
		"format:write": "biome check --write",
		"test": "node --test tests/*.test.js",
		"e2e": "npm run build:web && playwright test",
		"build:web": "vite build",
		"build:web:debug": "vite build --mode debug",
		"pack:web": "npm run build:web && rm -f dist/i2nclip-web.zip && cd dist/web && zip -q -r ../i2nclip-web.zip .",
		"test:packages": "node --test tests/packaging.js"
	},
	"dependencies": {
		"@serenity-kit/opaque": "1.1.0",
		"svelte": "^5.57.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "1.56.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte-check": "^4.3.0",
		"vite": "^8.3.4"
	}
}
