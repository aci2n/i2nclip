{
	"name": "i2nclip-client",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/aci2n/i2nclip"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check": "biome check --error-on-warnings && svelte-check --fail-on-warnings",
		"test": "node --test --test-timeout=60000 tests/*.test.js",
		"e2e": "cargo build --bin i2nclip --example test-server --example test-database && npm run build && playwright test",
		"build:extension": "node extension/build.js",
		"test:build": "npm run build && npm run build:extension && node --test tests/build.js",
		"fix": "biome check --write --error-on-warnings"
	},
	"dependencies": {
		"@serenity-kit/opaque": "1.1.0",
		"svelte": "^5.57.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "1.56.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte-check": "^4.3.0",
		"vite": "^8.3.4"
	}
}
