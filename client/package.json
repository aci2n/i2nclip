{
	"name": "i2nclip-client",
	"version": "0.1.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/aci2n/i2nclip"
	},
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"check": "svelte-check --fail-on-warnings",
		"lint": "biome lint",
		"format:check": "biome format",
		"format:write": "biome check --write",
		"test": "node --test --test-timeout=60000 tests/*.test.js",
		"e2e": "cargo build --bin i2nclip --example test-server --example test-database && npm run build && playwright test",
		"pack": "npm run build && rm -f dist/i2nclip-web.zip && cd dist/web && zip -q -r ../i2nclip-web.zip .",
		"pack:extension": "node extension/package.js",
		"test:package": "npm run pack && node --test tests/packaging.js"
	},
	"dependencies": {
		"@serenity-kit/opaque": "1.1.0",
		"svelte": "^5.57.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "1.56.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte-check": "^4.3.0",
		"vite": "^8.3.4"
	}
}
